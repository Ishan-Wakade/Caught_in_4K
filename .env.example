# Copy to .env (never commit .env). Owners are indicated in brackets.

# Worker [E] -> API [I]
WORKER_INGEST_TOKEN=
API_BASE_URL=http://localhost:3000
WORKER_PORT=8765

# Core [I]
DATABASE_URL=
CONFIG_PROFILE=demo            # normal | demo
CORE_STORAGE=postgres          # memory is available only for a single-process local demo
CORE_CONFIG_JSON={}
CONTACT_PHONES_JSON='{}'       # contact ID -> real phone, e.g. '{"ct_area_mgr":"+1..."}'; keep the single quotes; keep numbers out of git
MANAGER_API_TOKEN=             # required: protects manager mutations and mock replies
# RECYCLONE_ROOT=/absolute/path/to/Recyclone
# CORE_SITE_CONFIG_PATH=/absolute/path/to/site.json

# Photon/Spectrum [S]
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
PHOTON_CHANNEL=                # imessage | whatsapp_business; required for live messaging
PHOTON_WEBHOOK_SECRET=
PHOTON_CONTACT_MAP={}          # verified provider sender ID -> local configured contact ID
MESSENGER_MODE=mock            # mock | live
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_APP_SECRET=

# Grok [S] — live Illustrator implementation is still pending
GROK_API_KEY=
ILLUSTRATOR_MODE=mock          # mock | live
ENABLE_MOCK_REPLY=             # set true for explicit local demos; also requires MANAGER_API_TOKEN

# Web [J]
NEXT_PUBLIC_WORKER_URL=http://localhost:8765
