{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": [
      "node"
    ],
    "paths": {
      "@recyclone/core": [
        "./src/index.ts"
      ],
      "@recyclone/contracts": [
        "../../contracts/src/index.ts"
      ],
      "@recyclone/contracts/event-id": [
        "../../contracts/src/event-id.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts"
  ]
}
