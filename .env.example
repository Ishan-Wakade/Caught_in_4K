# Copy to .env (never commit .env). Owners are indicated in brackets.

# Worker [E] -> API [I]
WORKER_INGEST_TOKEN=
API_BASE_URL=http://localhost:3000
WORKER_PORT=8765

# Core [I]
DATABASE_URL=                  # also used by the dashboard's catalog DB (apps/web/lib/dashboard/db.ts), own table
CONFIG_PROFILE=demo            # normal | demo
CORE_STORAGE=postgres          # memory is available only for a single-process local demo
CORE_CONFIG_JSON={}
MANAGER_API_TOKEN=             # required: protects manager mutations (catalog, reviews, demo reset)
# RECYCLONE_ROOT=/absolute/path/to/Recyclone
# CORE_SITE_CONFIG_PATH=/absolute/path/to/site.json

# Grok [S] — live Illustrator implementation is still pending
GROK_API_KEY=
ILLUSTRATOR_MODE=mock          # mock | live

# Web [J]
NEXT_PUBLIC_WORKER_URL=http://localhost:8765

# Voice guide — server-only values, never NEXT_PUBLIC_ variables
DEEPSEEK_API_KEY=              # unfamiliar-item recognition
TYPESAFE_API_KEY=              # Jev disposal decisions under local rules
GUIDE_TOKEN=                   # bearer-like demo access token sent as x-guide-token

# Optional prerecorded worker gateway (export these or use ~/.config/recyclone/chalk.env; docs/chalk.md)
CHALK_ROUTER_API_KEY=
CHALK_ENVIRONMENT_ID=
CHALK_CLAUDE_MODEL=             # exact configured Chalk model ID or route
CHALK_DEEPSEEK_MODEL=
CHALK_JEV_MODEL=
