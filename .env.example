# Copy to .env (never commit .env). Owner of each variable in brackets.

# Shared by worker [E] and core [I]
WORKER_INGEST_TOKEN=

# Worker [E]
API_BASE_URL=http://localhost:3000
WORKER_PORT=8765

# Core [I]
DATABASE_URL=
CONFIG_PROFILE=demo            # normal | demo
CONTACT_PHONES_JSON=           # real phone numbers, kept out of git: {"ct_shakeshack_mgr":"+1...","ct_area_mgr":"+1..."}
MANAGER_API_TOKEN=             # required: protects catalog edits, review decisions, demo reset, mock-reply

# Integrations [S] — names may change once Photon/Grok docs are checked
PHOTON_API_KEY=
PHOTON_WEBHOOK_SECRET=
PHOTON_CHANNEL=
GROK_API_KEY=
MESSENGER_MODE=mock            # mock | live
ILLUSTRATOR_MODE=mock          # mock | live
ENABLE_MOCK_REPLY=             # set to "true" to allow POST /api/photon/mock-reply (also needs MANAGER_API_TOKEN); leave unset in any shared/public deployment

# Web [J]
NEXT_PUBLIC_WORKER_URL=http://localhost:8765
